  "cards": [
    {
      "dot": "cyan",
      "title": "Core location path",
      "items": [
        "The foreground service starts GPS / Network / Fused test providers.",
        "MotionEngine advances coordinates and the service pushes each fix.",
        "Standing down removes the test providers and restores the platform."
      ]
    },
    {
      "dot": "amber",
      "title": "Route capture",
      "items": [
        "RouteRecorder samples the live injected point while a session runs.",
        "It filters points closer than 1.5 m and saves a replayable RoutePlan."
      ]
    },
    {
      "dot": "rose",
      "title": "Frida sensor bridge",
      "items": [
        "The app generates the JavaScript and can copy it to /data/local/tmp.",
        "A root frida-server or Frida Gadget must inject it into the target process.",
        "Shizuku can deploy files and grant AppOps; it cannot ptrace another app."
      ]
    },
    {
      "dot": "slate",
      "title": "Outside this slice",
      "items": [
        "AMap / OSM tiles, Photon geocoding and GitHub Release checks use HTTPS.",
        "App scan, cache snapshot and real-GPS probe are secondary feature branches."
      ]
    }
  ]
