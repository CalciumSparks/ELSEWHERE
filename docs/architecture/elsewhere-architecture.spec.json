  "cards": [
    {
      "dot": "cyan",
      "title": "Core location path",
      "items": [
        "The foreground service starts GPS / Network / Fused test providers.",
        "MotionEngine advances coordinates and the service pushes each fix.",
        "Standing down removes the test providers and restores the platform."
      ]
    },
    {
      "dot": "amber",
      "title": "Route capture",
      "items": [
        "RouteRecorder samples the live injected point while a session runs.",
        "It filters points closer than 1.5 m and saves a replayable RoutePlan."
      ]
    },
    {
      "dot": "rose",
      "title": "Frida sensor bridge",
      "items": [
        "JDWP: no root, frida-jdwp-loader, debuggable targets only.",
        "Root frida-server covers any app; Gadget requires repackaging.",
        "Shizuku deploys files and grants AppOps; it cannot ptrace another app."
      ]
    },
    {
      "dot": "slate",
      "title": "Outside this slice",
      "items": [
        "AMap / OSM tiles, Photon geocoding and GitHub Release checks use HTTPS.",
        "App scan, cache snapshot and real-GPS probe are secondary feature branches."
      ]
    },
    {
      "dot": "violet",
      "title": "LSPatch / VirtualXposed",
      "items": [
        "These are patch-or-virtualize routes, not JDWP injection.",
        "LSPatch needs an Xposed module and a modified APK.",
        "VirtualXposed runs the target inside its virtual space.",
        "Neither is integrated in this build; JDWP is the no-repackaging route."
      ]
    },
    {
      "dot": "violet",
      "title": "LSPatch / Xposed",
      "items": [
        "Separate APK patched or virtualized target; no root.",
        "Module hooks dispatchSensorEvent on API 82.",
        "Global config: Settings.Global.elsewhere_sensor_config."
      ]
    }
  ]
}
